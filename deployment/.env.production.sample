# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id
ECS_CLUSTER=fund-analysis-cluster

# ECR Configuration
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
ECR_REPOSITORY=fund-analysis
IMAGE_TAG=latest

# Network Configuration
SUBNET_ID_1=subnet-xxxxx
SUBNET_ID_2=subnet-yyyyy
SECURITY_GROUP_ID=sg-xxxxx
TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:${AWS_REGION}:${AWS_ACCOUNT_ID}:targetgroup/fund-analysis/xxxxxx
SERVICE_DISCOVERY_ARN=arn:aws:servicediscovery:${AWS_REGION}:${AWS_ACCOUNT_ID}:service/srv-xxxxx

# Application Configuration
ENVIRONMENT=production

# AWS Systems Manager Parameter Store paths will be:
# /fund-analysis/production/database_url
# /fund-analysis/production/redis_url
# /fund-analysis/production/openai_api_key

# Scaling Configuration
MIN_CAPACITY=2
MAX_CAPACITY=10
TARGET_CPU_UTILIZATION=75
TARGET_MEMORY_UTILIZATION=75

# IAM Roles (must exist before deployment)
# - ecsTaskExecutionRole: Required for ECS to pull container images and publish logs
# - ecsTaskRole: Required for containers to access AWS services